rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(cid) { return get(/databases/$(database)/documents/companies/$(cid)/members/$(request.auth.uid)).data; }
  function active(cid) { return signed() && member(cid).status == 'ACTIVE' && get(/databases/$(database)/documents/companies/$(cid)).data.status == 'ACTIVE'; }
  function manager(cid) { return active(cid) && member(cid).role in ['OWNER', 'ADMIN']; }
  match /users/{uid} { allow read: if signed() && request.auth.uid == uid; }
  match /companies/{cid} {
   allow read: if active(cid);
   match /members/{uid} { allow read: if signed() && (request.auth.uid == uid || manager(cid)); }
   match /employees/{eid} { allow read: if manager(cid); }
   match /calls/{callId} { allow read: if active(cid) && (manager(cid) || resource.data.employeeUid == request.auth.uid); }
   match /devices/{deviceId} { allow read: if active(cid) && (manager(cid) || resource.data.employeeUid == request.auth.uid); }
   match /daily/{day} { allow read: if active(cid) && (manager(cid) || resource.data.employeeUid == request.auth.uid); }
   match /notifications/{nid} { allow read: if manager(cid); }
   match /audit/{aid} { allow read: if active(cid) && member(cid).role == 'OWNER'; }
  }
  match /{document=**} { allow write: if false; }
 }
}
