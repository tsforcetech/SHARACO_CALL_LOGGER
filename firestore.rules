rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function verified() { return signed() && request.auth.token.email_verified == true; }
  function company(cid) { return get(/databases/$(database)/documents/companies/$(cid)).data; }
  function member(cid, uid) { return get(/databases/$(database)/documents/companies/$(cid)/members/$(uid)).data; }
  function active(cid) { return signed() && member(cid, request.auth.uid).approved == true; }
  function owner(cid) { return signed() && company(cid).ownerUid == request.auth.uid; }
  function admin(cid) { return active(cid) && member(cid, request.auth.uid).role in ['owner','admin']; }
  function ma(cid, uid) { return getAfter(/databases/$(database)/documents/companies/$(cid)/members/$(uid)).data; }
  function ix(cid, uid) { return getAfter(/databases/$(database)/documents/users/$(uid)/companies/$(cid)).data; }
  function jr(cid, uid) { return getAfter(/databases/$(database)/documents/companies/$(cid)/join_requests/$(uid)).data; }
  function inv(token) { return get(/databases/$(database)/documents/invitations/$(token)).data; }
  function valid(i) { return !i.revoked && i.expiresAt > request.time; }
  function emp(cid, eid) { return getAfter(/databases/$(database)/documents/companies/$(cid)/employees/$(eid)).data; }
  function approved(cid, uid) { return ma(cid, uid).approved == true && ma(cid, uid).role == 'employee'
   && jr(cid, uid).status == 'approved' && ix(cid, uid).status == 'approved' && ix(cid, uid).role == 'employee'; }
  function canReadCall(cid) { return admin(cid) || (active(cid) && (resource.data.uid == request.auth.uid
   || member(cid, request.auth.uid).get('assignedUsers', []).hasAny([resource.data.uid]))); }
  function device(cid, uid, did) { return get(/databases/$(database)/documents/companies/$(cid)/devices/$(uid + '_' + did)).data; }
  function deviceAfter(cid, uid, did) { return getAfter(/databases/$(database)/documents/companies/$(cid)/devices/$(uid + '_' + did)).data; }
  function currentDevice(cid, did) { return active(cid) && member(cid, request.auth.uid).activeDeviceId == did
   && device(cid, request.auth.uid, did).uid == request.auth.uid && device(cid, request.auth.uid, did).status == 'active'; }
  function deviceShape(d) { return d.keys().hasOnly(['uid','deviceId','employeeName','manufacturer','model','androidVersion','appVersion','status','registeredAt','consentAt','lastSeen','callLogPermission','notificationPermission','pendingRecordCount','lastSyncError','lastSyncAttemptStatus','lastSuccessfulSyncAt'])
   && d.deviceId.matches('[0-9a-fA-F-]{36}') && d.model is string && d.model.size() <= 100
   && d.manufacturer is string && d.manufacturer.size() <= 100 && d.androidVersion is string && d.androidVersion.size() <= 50
   && d.appVersion is string && d.appVersion.size() <= 50 && d.callLogPermission is bool && d.notificationPermission is bool
   && d.pendingRecordCount is int && d.pendingRecordCount >= 0 && d.lastSyncError is string && d.lastSyncError.size() <= 500
   && d.lastSyncAttemptStatus is string && d.lastSyncAttemptStatus.size() <= 100; }
  function callShape(cid, callId, d) { return d.uid == request.auth.uid && d.companyId == cid
   && currentDevice(cid, d.deviceId) && d.deviceCallId == callId
   && d.type in ['INCOMING','OUTGOING','MISSED','REJECTED','BLOCKED','VOICEMAIL','ANSWERED_EXTERNALLY','UNKNOWN','OTHER']
   && d.startedAt is int && d.startedAt >= member(cid, request.auth.uid).initialSyncFrom && d.startedAt <= request.time.toMillis() + 300000
   && d.durationSec is int && d.durationSec >= 0 && d.durationSec <= 604800
   && d.remoteNumber is string && d.remoteNumber.size() <= 100 && d.contactName is string && d.contactName.size() <= 200
   && d.keys().hasOnly(['uid','companyId','sim','fromNumber','toNumber','remoteNumber','contactName','type','startedAt','durationSec','createdAt','deviceCallId','deviceId']); }
  match /companies/{cid} {
   allow create: if verified()
    && request.resource.data.keys().hasOnly(['name','ownerUid','createdAt','joinToken'])
    && request.resource.data.ownerUid == request.auth.uid
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 160
    && request.resource.data.joinToken.matches('[0-9A-F]{32}') && request.resource.data.createdAt == request.time
    && ma(cid, request.auth.uid).uid == request.auth.uid && ma(cid, request.auth.uid).role == 'owner'
    && ma(cid, request.auth.uid).approved == true && ix(cid, request.auth.uid).role == 'owner' && ix(cid, request.auth.uid).status == 'approved';
   allow get, list: if owner(cid) || active(cid);
   allow update: if owner(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','joinToken']);
   match /settings/{id} {
    allow read: if active(cid);
    allow create, update: if signed() && id == 'profile'
     && getAfter(/databases/$(database)/documents/companies/$(cid)).data.ownerUid == request.auth.uid
     && request.resource.data.keys().hasOnly(['industry','country','timeZone','phone','email','address','workingHours','retentionDays','initialSyncPolicy','notificationsEnabled','logo']);
   }
   match /members/{uid} {
    allow get: if signed() && (request.auth.uid == uid || admin(cid));
    allow list: if admin(cid);
    allow create: if verified() && request.resource.data.keys().hasOnly(['uid','role','approved','name','email','sim'])
     && request.resource.data.uid == uid && request.resource.data.approved == true
     && request.resource.data.name is string && request.resource.data.sim is string
     && ((uid == request.auth.uid && request.resource.data.role == 'owner'
       && request.resource.data.email == request.auth.token.email
       && getAfter(/databases/$(database)/documents/companies/$(cid)).data.ownerUid == uid
       && ix(cid, uid).role == 'owner' && ix(cid, uid).status == 'approved')
      || (admin(cid) && approved(cid, uid) && request.resource.data.email == jr(cid, uid).email
       && request.resource.data.name == jr(cid, uid).name && emp(cid, jr(cid, uid).employeeId).uid == uid));
    allow update: if (owner(cid) && uid != request.auth.uid && request.resource.data.uid == uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','approved'])
      && request.resource.data.role in ['employee','admin','supervisor'] && request.resource.data.approved is bool)
     || (active(cid) && uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sim'])
      && request.resource.data.sim.matches('\\+[0-9]{8,15}'))
     || (active(cid) && uid == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeDeviceId','initialSyncFrom'])
      && request.resource.data.activeDeviceId.matches('[0-9a-fA-F-]{36}')
      && request.resource.data.initialSyncFrom is int
      && ((resource.data.get('initialSyncFrom',0) == 0 && request.resource.data.initialSyncFrom >= request.time.toMillis() - 86400000 && request.resource.data.initialSyncFrom <= request.time.toMillis())
       || (resource.data.get('initialSyncFrom',0) > 0 && request.resource.data.initialSyncFrom == resource.data.initialSyncFrom))
      && deviceAfter(cid, uid, request.resource.data.activeDeviceId).uid == uid
      && deviceAfter(cid, uid, request.resource.data.activeDeviceId).status == 'active'
      && deviceAfter(cid, uid, request.resource.data.activeDeviceId).lastSeen == request.time
      && (resource.data.get('activeDeviceId','') == '' || resource.data.activeDeviceId == request.resource.data.activeDeviceId
       || deviceAfter(cid, uid, resource.data.activeDeviceId).status == 'inactive'));
    allow delete: if owner(cid) && uid != request.auth.uid;
   }
   match /employees/{eid} {
    allow read: if admin(cid);
    allow create: if admin(cid) && request.resource.data.keys().hasOnly(['name','code','email','mobile','department','designation','status','uid'])
     && request.resource.data.uid == '' && request.resource.data.status == 'INVITED'
     && request.resource.data.email is string && request.resource.data.email.size() <= 254;
    allow update: if admin(cid) && (
      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','code','mobile','department','designation','email'])
      || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inviteCode']) && resource.data.uid == '' && resource.data.status == 'INVITED'
       && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)).data.employeeId == eid
       && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)).data.companyId == cid)
      || (resource.data.uid == '' && resource.data.status == 'INVITED'
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','status']) && request.resource.data.status == 'ACTIVE'
       && approved(cid, request.resource.data.uid) && jr(cid, request.resource.data.uid).employeeId == eid));
   }
   match /join_requests/{uid} {
    allow get: if signed() && (request.auth.uid == uid || admin(cid));
    allow list: if admin(cid);
    allow create: if verified() && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['uid','name','sim','token','status','requestedAt','email','employeeId'])
     && request.resource.data.uid == uid && request.resource.data.status == 'pending'
     && request.resource.data.email == request.auth.token.email.lower() && request.resource.data.requestedAt == request.time
     && request.resource.data.name is string && request.resource.data.sim is string
     && inv(request.resource.data.token).companyId == cid && inv(request.resource.data.token).employeeId == request.resource.data.employeeId
     && inv(request.resource.data.token).email == request.auth.token.email.lower()
     && inv(request.resource.data.token).claimedBy == '' && valid(inv(request.resource.data.token))
     && emp(cid, request.resource.data.employeeId).email == request.resource.data.email
     && emp(cid, request.resource.data.employeeId).inviteCode == request.resource.data.token
     && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.token)).data.claimedBy == uid
     && ix(cid, uid).status == 'pending' && ix(cid, uid).role == 'employee';
    allow update: if admin(cid) && resource.data.status == 'pending'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'approved'
     && approved(cid, uid) && valid(inv(resource.data.token)) && inv(resource.data.token).claimedBy == uid
     && emp(cid, resource.data.employeeId).uid == uid
     && emp(cid, resource.data.employeeId).email == resource.data.email
     && emp(cid, resource.data.employeeId).inviteCode == resource.data.token;
   }
   match /devices/{deviceId} {
    allow get: if admin(cid) || (active(cid) && deviceId.matches(request.auth.uid + '_[0-9a-fA-F-]{36}'));
    allow list: if admin(cid) || (active(cid) && resource.data.uid == request.auth.uid);
    allow create: if active(cid) && deviceShape(request.resource.data)
     && request.resource.data.uid == request.auth.uid && deviceId == request.auth.uid + '_' + request.resource.data.deviceId
     && request.resource.data.employeeName == member(cid, request.auth.uid).name
     && request.resource.data.status == 'active' && request.resource.data.callLogPermission == true
     && request.resource.data.registeredAt == request.time && request.resource.data.consentAt == request.time
     && request.resource.data.lastSeen == request.time && !request.resource.data.keys().hasAny(['lastSuccessfulSyncAt'])
     && ma(cid, request.auth.uid).activeDeviceId == request.resource.data.deviceId;
    allow update: if (admin(cid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'inactive')
     || (active(cid) && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid
      && request.resource.data.deviceId == resource.data.deviceId && deviceShape(request.resource.data)
      && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'inactive'
        && ma(cid, request.auth.uid).activeDeviceId != resource.data.deviceId)
       || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['employeeName','manufacturer','model','androidVersion','appVersion','status','lastSeen','callLogPermission','notificationPermission','pendingRecordCount','lastSyncError','lastSyncAttemptStatus','lastSuccessfulSyncAt'])
        && request.resource.data.status == 'active' && ma(cid, request.auth.uid).activeDeviceId == resource.data.deviceId
        && request.resource.data.lastSeen == request.time && request.resource.data.employeeName == member(cid, request.auth.uid).name
        && (resource.data.status == 'active' || request.resource.data.callLogPermission == true)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSuccessfulSyncAt']) || request.resource.data.lastSuccessfulSyncAt == request.time))));
   }
   match /call_logs/{callId} {
    allow get: if canReadCall(cid) || (active(cid) && !exists(/databases/$(database)/documents/companies/$(cid)/call_logs/$(callId)));
    allow list: if canReadCall(cid);
    allow create: if callShape(cid, callId, request.resource.data)
     && request.resource.data.sim == member(cid, request.auth.uid).sim && request.resource.data.createdAt == request.time;
    allow update: if callShape(cid, callId, request.resource.data)
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','durationSec']);
   }
   match /assigned_numbers/{itemId} {
    allow get, list: if admin(cid) || (active(cid) && resource.data.assignedTo == request.auth.uid);
    allow create: if admin(cid) && request.resource.data.keys().hasOnly(['phone','name','notes','assignedTo','status','createdBy','createdAt','updatedAt'])
     && request.resource.data.phone is string && request.resource.data.phone.size() >= 9 && request.resource.data.phone.size() <= 16
     && request.resource.data.status == 'pending' && request.resource.data.createdBy == request.auth.uid && member(cid, request.resource.data.assignedTo).approved == true;
    allow update: if active(cid) && (admin(cid) || resource.data.assignedTo == request.auth.uid)
     && request.resource.data.assignedTo == resource.data.assignedTo
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','contactedBy','contactedAt','outcome','nextFollowUp','lastUpdatedBy','updatedAt'])
     && request.resource.data.status in ['pending','contacted','interested','follow_up','won','lost']
     && request.resource.data.get('outcome','') is string && request.resource.data.get('outcome','').size() <= 1000
     && request.resource.data.get('nextFollowUp','') is string && request.resource.data.get('nextFollowUp','').size() <= 30
     && request.resource.data.get('lastUpdatedBy',request.auth.uid) == request.auth.uid && request.resource.data.get('contactedBy',request.auth.uid) == request.auth.uid;
   }
   // Spark CRM: clients are untrusted. Each workflow must commit its related records together.
   function lead(lid) { return get(/databases/$(database)/documents/companies/$(cid)/leads/$(lid)).data; }
   function leadAfter(lid) { return getAfter(/databases/$(database)/documents/companies/$(cid)/leads/$(lid)).data; }
   function attemptAfter(aid) { return getAfter(/databases/$(database)/documents/companies/$(cid)/crmCallAttempts/$(aid)).data; }
   function disposition(sid) { return get(/databases/$(database)/documents/companies/$(cid)/dispositionStatuses/$(sid)).data; }
   function mine(d) { return active(cid) && d.employeeUid == request.auth.uid; }
   function ownLead(lid) { return active(cid) && lead(lid).assignedTo == request.auth.uid; }
   function openClaim(lid, sid) { return ownLead(lid) && lead(lid).claimSessionId == sid
    && lead(lid).claimedBy == request.auth.uid && lead(lid).claimExpiresAt > request.time.toMillis(); }
   function pair() { return get(/databases/$(database)/documents/companies/$(cid)/webDevicePairings/$(request.auth.uid)).data; }
   function pairIdentity(d) { return active(cid) && d.employeeUid == request.auth.uid
    && d.pairingId == pair().pairingId && d.deviceId == pair().deviceId && pair().enabled == true
    && pair().expiresAt > request.time.toMillis()
    && currentDevice(cid, d.deviceId); }
   function paired(d) { return pairIdentity(d) && pair().readyUntil > request.time.toMillis(); }
   match /campaigns/{campaignId} {
    allow read: if admin(cid) || (active(cid) && request.auth.uid in resource.data.get('employeeUids', []));
    allow create, update: if admin(cid) && request.resource.data.name is string
     && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
     && request.resource.data.status in ['draft','active','paused','completed','archived'];
   }
   match /dispositionStatuses/{sid} {
    allow read: if active(cid);
    allow create, update: if admin(cid) && request.resource.data.statusId == sid
     && request.resource.data.active is bool && request.resource.data.isTerminal is bool
     && request.resource.data.requiresRemarks is bool && request.resource.data.requiresFollowUp is bool
     && request.resource.data.countsAsInterested is bool && request.resource.data.countsAsConversion is bool
     && request.resource.data.label is string && request.resource.data.label.size() <= 80;
   }
   match /leads/{lid} {
    allow read: if admin(cid) || (active(cid) && resource.data.assignedTo == request.auth.uid);
    allow create: if admin(cid) && request.resource.data.companyId == cid && request.resource.data.leadId == lid
     && member(cid, request.resource.data.assignedTo).approved == true
     && request.resource.data.customerName is string && request.resource.data.customerName.size() <= 160
     && request.resource.data.primaryPhone.matches('\\+[1-9][0-9]{7,14}')
     && request.resource.data.version == 1 && request.resource.data.createdAt == request.time;
    allow update: if admin(cid) && request.resource.data.companyId == cid && request.resource.data.leadId == lid
     && request.resource.data.version == resource.data.version + 1;
    allow update: if active(cid) && resource.data.assignedTo == request.auth.uid && (
     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy','claimSessionId','claimExpiresAt'])
      && !resource.data.terminal && !resource.data.doNotCall
      && (resource.data.get('claimExpiresAt',0) <= request.time.toMillis() || resource.data.get('claimedBy','') == request.auth.uid)
      && request.resource.data.claimedBy == request.auth.uid
      && request.resource.data.claimExpiresAt > request.time.toMillis()
      && request.resource.data.claimExpiresAt <= request.time.toMillis() + 900000
      && getAfter(/databases/$(database)/documents/companies/$(cid)/callingSessions/$(request.resource.data.claimSessionId)).data.employeeUid == request.auth.uid
      && getAfter(/databases/$(database)/documents/companies/$(cid)/callingSessions/$(request.resource.data.claimSessionId)).data.leadId == lid)
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','terminal','doNotCall','remarks','tags','nextFollowUpAt','lastContactAt','updatedAt','version','claimedBy','claimSessionId','claimExpiresAt','lastAttemptId'])
      && openClaim(lid, resource.data.claimSessionId)
      && request.resource.data.version == resource.data.version + 1
      && attemptAfter(request.resource.data.lastAttemptId).leadId == lid
      && attemptAfter(request.resource.data.lastAttemptId).employeeUid == request.auth.uid
      && attemptAfter(request.resource.data.lastAttemptId).createdAt == request.time
      && request.resource.data.status == attemptAfter(request.resource.data.lastAttemptId).dispositionId
      && request.resource.data.remarks == attemptAfter(request.resource.data.lastAttemptId).remarks
      && request.resource.data.tags == attemptAfter(request.resource.data.lastAttemptId).tags
      && request.resource.data.nextFollowUpAt == attemptAfter(request.resource.data.lastAttemptId).nextFollowUpAt
      && request.resource.data.terminal == disposition(request.resource.data.status).isTerminal
      && request.resource.data.doNotCall == (request.resource.data.status == 'do_not_call')
      && request.resource.data.claimedBy == '' && request.resource.data.claimSessionId == '' && request.resource.data.claimExpiresAt == 0
      && request.resource.data.updatedAt == request.time && request.resource.data.lastContactAt == request.time));
   }
   match /callingSessions/{sid} {
    allow read: if admin(cid) || mine(resource.data);
    allow create: if mine(request.resource.data) && ownLead(request.resource.data.leadId)
     && request.resource.data.keys().hasOnly(['employeeUid','leadId','status','createdAt','expiresAt'])
     && request.resource.data.status == 'READY' && request.resource.data.createdAt == request.time
     && leadAfter(request.resource.data.leadId).claimSessionId == sid
     && request.resource.data.expiresAt == leadAfter(request.resource.data.leadId).claimExpiresAt;
    allow update: if mine(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','attemptId'])
     && resource.data.status == 'READY' && request.resource.data.status == 'DISPOSITION_SAVED'
     && attemptAfter(request.resource.data.attemptId).sessionId == sid;
   }
   match /crmCallAttempts/{aid} {
    allow read: if admin(cid) || mine(resource.data);
    allow create: if mine(request.resource.data) && request.resource.data.attemptId == aid && request.resource.data.companyId == cid
     && request.resource.data.keys().hasOnly(['attemptId','companyId','leadId','employeeUid','campaignId','sessionId','dispositionId','remarks','tags','nextFollowUpAt','createdAt','verificationStatus','matchedCallId','durationSeconds','connectionStatus'])
     && openClaim(request.resource.data.leadId, request.resource.data.sessionId)
     && disposition(request.resource.data.dispositionId).active == true
     && request.resource.data.verificationStatus == 'UNVERIFIED' && request.resource.data.matchedCallId == null
     && request.resource.data.durationSeconds == null && request.resource.data.connectionStatus == 'UNKNOWN'
     && request.resource.data.campaignId == lead(request.resource.data.leadId).campaignId
     && request.resource.data.remarks is string && request.resource.data.remarks.size() <= 1000
     && (!disposition(request.resource.data.dispositionId).requiresRemarks || request.resource.data.remarks.size() > 0)
     && request.resource.data.tags is list && request.resource.data.tags.size() <= 20
     && (request.resource.data.nextFollowUpAt == null || (request.resource.data.nextFollowUpAt is int && request.resource.data.nextFollowUpAt > request.time.toMillis()))
     && (!disposition(request.resource.data.dispositionId).requiresFollowUp || request.resource.data.nextFollowUpAt != null)
     && (request.resource.data.nextFollowUpAt == null || getAfter(/databases/$(database)/documents/companies/$(cid)/followUps/$(aid)).data.dueAt == request.resource.data.nextFollowUpAt)
     && request.resource.data.createdAt == request.time
     && leadAfter(request.resource.data.leadId).lastAttemptId == aid
     && getAfter(/databases/$(database)/documents/companies/$(cid)/callingSessions/$(request.resource.data.sessionId)).data.attemptId == aid
     && getAfter(/databases/$(database)/documents/companies/$(cid)/leadActivities/$(aid)).data.attemptId == aid;
   }
   match /leadActivities/{aid} {
    allow read: if admin(cid) || mine(resource.data);
    allow create: if mine(request.resource.data) && request.resource.data.diff(attemptAfter(aid)).affectedKeys().hasOnly(['type'])
     && request.resource.data.type == 'DISPOSITION' && attemptAfter(aid).createdAt == request.time;
   }
   match /followUps/{fid} {
    allow read: if admin(cid) || mine(resource.data);
    allow create: if mine(request.resource.data) && request.resource.data.keys().hasOnly(['leadId','employeeUid','dueAt','status','remarks','createdAt'])
     && request.resource.data.leadId == attemptAfter(fid).leadId && request.resource.data.employeeUid == attemptAfter(fid).employeeUid
     && request.resource.data.dueAt == attemptAfter(fid).nextFollowUpAt && request.resource.data.remarks == attemptAfter(fid).remarks
     && attemptAfter(fid).createdAt == request.time && request.resource.data.createdAt == request.time && request.resource.data.status == 'pending';
   }
   match /targetDefinitions/{tid} {
    allow read: if admin(cid) || mine(resource.data);
    allow create: if admin(cid) && member(cid,request.resource.data.employeeUid).approved == true
     && request.resource.data.value is number && request.resource.data.value > 0
     && request.resource.data.period in ['daily','weekly','monthly','custom'] && request.resource.data.createdAt == request.time;
   }
   match /webDevicePairings/{uid} {
    allow read: if active(cid) && request.auth.uid == uid;
    allow create, update: if active(cid) && request.auth.uid == uid && request.resource.data.employeeUid == uid
     && request.resource.data.keys().hasOnly(['employeeUid','deviceId','pairingId','enabled','expiresAt','readyUntil','updatedAt'])
     && currentDevice(cid,request.resource.data.deviceId) && request.resource.data.pairingId.matches('[0-9a-f-]{36}')
     && request.resource.data.enabled is bool && request.resource.data.updatedAt == request.time
     && request.resource.data.expiresAt is int && request.resource.data.expiresAt <= request.time.toMillis() + 28800000
     && request.resource.data.readyUntil is int && request.resource.data.readyUntil <= request.time.toMillis() + 90000;
   }
   match /callRequests/{rid} {
    allow read: if mine(resource.data);
    allow create: if paired(request.resource.data) && request.resource.data.requestId == rid
     && request.resource.data.keys().hasOnly(['requestId','employeeUid','deviceId','pairingId','leadId','phoneNumber','status','createdAt','expiresAt'])
     && ownLead(request.resource.data.leadId) && !lead(request.resource.data.leadId).terminal && !lead(request.resource.data.leadId).doNotCall
     && request.resource.data.phoneNumber == lead(request.resource.data.leadId).primaryPhone
     && request.resource.data.phoneNumber.matches('\\+[1-9][0-9]{7,14}')
     && request.resource.data.status == 'CREATED' && request.resource.data.createdAt == request.time
     && request.resource.data.expiresAt is int && request.resource.data.expiresAt > request.time.toMillis()
     && request.resource.data.expiresAt <= request.time.toMillis() + 60000;
    allow update: if pairIdentity(resource.data) && ownLead(resource.data.leadId) && !lead(resource.data.leadId).doNotCall && !lead(resource.data.leadId).terminal
     && resource.data.expiresAt > request.time.toMillis()
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
     && ((resource.data.status == 'CREATED' && pair().readyUntil > request.time.toMillis() && request.resource.data.status in ['ACKNOWLEDGED','CANCELLED'])
      || (resource.data.status == 'ACKNOWLEDGED' && request.resource.data.status == 'DIALER_OPENED'));
   }
  }
  match /invitations/{token} {
   allow get: if verified() && (resource.data.email == request.auth.token.email.lower() || admin(resource.data.companyId));
   allow create: if admin(request.resource.data.companyId) && token.matches('[0-9A-F]{32}')
    && request.resource.data.keys().hasOnly(['companyId','employeeId','companyName','employeeName','employeeCode','email','expiresAt','revoked','claimedBy'])
    && request.resource.data.email == emp(request.resource.data.companyId, request.resource.data.employeeId).email
    && emp(request.resource.data.companyId, request.resource.data.employeeId).inviteCode == token
    && emp(request.resource.data.companyId, request.resource.data.employeeId).uid == ''
    && request.resource.data.companyName == company(request.resource.data.companyId).name
    && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(31,'d')
    && request.resource.data.revoked == false && request.resource.data.claimedBy == '';
   allow update: if (admin(resource.data.companyId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) && request.resource.data.revoked == true)
    || (verified() && resource.data.email == request.auth.token.email.lower() && valid(resource.data) && resource.data.claimedBy == ''
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy']) && request.resource.data.claimedBy == request.auth.uid
     && jr(resource.data.companyId, request.auth.uid).token == token && jr(resource.data.companyId, request.auth.uid).status == 'pending');
  }
  match /users/{uid}/companies/{cid} {
   allow get, list: if signed() && request.auth.uid == uid;
   allow create, update: if signed() && request.resource.data.keys().hasOnly(['name','role','status','updatedAt'])
    && request.resource.data.updatedAt == request.time && (
     (uid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.role == 'employee'
      && jr(cid, uid).status == 'pending' && request.resource.data.name == inv(jr(cid, uid).token).companyName)
     || (request.resource.data.status == 'approved'
      && request.resource.data.name == getAfter(/databases/$(database)/documents/companies/$(cid)).data.name
      && request.resource.data.role == ma(cid, uid).role && ma(cid, uid).approved == true
      && ((uid == request.auth.uid && getAfter(/databases/$(database)/documents/companies/$(cid)).data.ownerUid == uid)
       || (admin(cid) && approved(cid, uid)))));
  }
  match /{document=**} { allow write: if false; }
 }
}
